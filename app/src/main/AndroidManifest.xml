<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- صلاحيات البلوتوث الكلاسيكية -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    
    <!-- صلاحيات البلوتوث الحديثة (أندرويد 12 وما فوق) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    
    <!-- صلاحية الإنترنت للتواصل مع الذكاء الاصطناعي (Gemini) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- صلاحية الميكروفون لالتقاط الأوامر الصوتية -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- صلاحية العمل في الخلفية للاستماع لأزرار السماعة -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Mibro AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MibroAI"
        tools:targetApi="31">
        
        <!-- واجهة التطبيق الرئيسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MibroAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- خدمة الخلفية للتحكم بأزرار السماعة -->
        <service 
            android:name=".MibroMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- مستقبل أوامر السماعة (Media Button Receiver) -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
